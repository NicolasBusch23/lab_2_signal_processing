import pandas as pd

def extraccion(num_sujeto, actividad, inicio, fin):
    df_s = pd.read_csv(f"datos_csv\\s{num_sujeto}_{actividad}.csv")
    df_s["time"] = pd.to_datetime(df_s["time"], format="%Y-%m-%d   %H:%M:%S.%f")

    # Para pasar de datetime a tiempo transcurrido desde el inicio del experimento (df_s['time'].iloc[0])
    tiempo_transcurrido = df_s['time'] - df_s['time'].iloc[0]
    df_s['segundos_transcurridos'] = tiempo_transcurrido.dt.total_seconds() # Convierte el tiempo transcurrido a segundos

    # Para filtrar los datos de acuerdo a los segundos de interés
    df_filtrada = df_s.query(f"segundos_transcurridos >= {inicio} and segundos_transcurridos <= {fin}")
    t = df_filtrada['segundos_transcurridos']
    ecg = df_filtrada['ecg']

    return df_filtrada


